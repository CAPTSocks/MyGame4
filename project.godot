config_version=5

[application]

config/name="LumberJane"
run/main_scene="res://Levels/TestLevel.tscn"
config/features=PackedStringArray("4.1", "C#")
config/icon="res://Sprites/icon.png"

[autoload]

Global="*res://Prefabs/Global.tscn"
GlobalCollectibles="*res://Prefabs/GlobalCollectibles.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="2d"
window/vsync/vsync_mode=false

